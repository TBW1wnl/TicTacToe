<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TicTacToe.Maui.ViewModels"
             x:Class="TicTacToe.Maui.Views.GamePage"
             x:DataType="vm:GameViewModel"
             Title="TicTacToe"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="28,56,28,40">

        <VerticalStackLayout Grid.Row="0" Spacing="4">

            <Label Text="TicTacToe"
                   FontSize="38"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"
                   CharacterSpacing="2"/>

            <Label Text="Player (X) vs Bot (O)"
                   FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="20">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="4">

                <Label Text="{Binding StatusEmoji}"
                       FontSize="32"
                       HorizontalOptions="Center"/>

                <Label Text="{Binding StatusMessage}"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource AccentX}"
                               HeightRequest="28"
                               HorizontalOptions="Center"/>

            <Grid ColumnDefinitions="*,*,*"
                  RowDefinitions="*,*,*"
                  ColumnSpacing="10"
                  RowSpacing="10"
                  HorizontalOptions="Center"
                  WidthRequest="320"
                  HeightRequest="320">

                <Button Grid.Row="0" Grid.Column="0"
                        Text="{Binding Cells[0].Symbol}"
                        TextColor="{Binding Cells[0].TextColor}"
                        BackgroundColor="{Binding Cells[0].BackgroundColor}"
                        Command="{Binding Cells[0].TapCommand}"
                        IsEnabled="{Binding Cells[0].IsEnabled}"
                        Style="{StaticResource CellButtonStyle}"/>

                <Button Grid.Row="0" Grid.Column="1"
                        Text="{Binding Cells[1].Symbol}"
                        TextColor="{Binding Cells[1].TextColor}"
                        BackgroundColor="{Binding Cells[1].BackgroundColor}"
                        Command="{Binding Cells[1].TapCommand}"
                        IsEnabled="{Binding Cells[1].IsEnabled}"
                        Style="{StaticResource CellButtonStyle}"/>

                <Button Grid.Row="0" Grid.Column="2"
                        Text="{Binding Cells[2].Symbol}"
                        TextColor="{Binding Cells[2].TextColor}"
                        BackgroundColor="{Binding Cells[2].BackgroundColor}"
                        Command="{Binding Cells[2].TapCommand}"
                        IsEnabled="{Binding Cells[2].IsEnabled}"
                        Style="{StaticResource CellButtonStyle}"/>

                <Button Grid.Row="1" Grid.Column="0"
                        Text="{Binding Cells[3].Symbol}"
                        TextColor="{Binding Cells[3].TextColor}"
                        BackgroundColor="{Binding Cells[3].BackgroundColor}"
                        Command="{Binding Cells[3].TapCommand}"
                        IsEnabled="{Binding Cells[3].IsEnabled}"
                        Style="{StaticResource CellButtonStyle}"/>

                <Button Grid.Row="1" Grid.Column="1"
                        Text="{Binding Cells[4].Symbol}"
                        TextColor="{Binding Cells[4].TextColor}"
                        BackgroundColor="{Binding Cells[4].BackgroundColor}"
                        Command="{Binding Cells[4].TapCommand}"
                        IsEnabled="{Binding Cells[4].IsEnabled}"
                        Style="{StaticResource CellButtonStyle}"/>

                <Button Grid.Row="1" Grid.Column="2"
                        Text="{Binding Cells[5].Symbol}"
                        TextColor="{Binding Cells[5].TextColor}"
                        BackgroundColor="{Binding Cells[5].BackgroundColor}"
                        Command="{Binding Cells[5].TapCommand}"
                        IsEnabled="{Binding Cells[5].IsEnabled}"
                        Style="{StaticResource CellButtonStyle}"/>

                <Button Grid.Row="2" Grid.Column="0"
                        Text="{Binding Cells[6].Symbol}"
                        TextColor="{Binding Cells[6].TextColor}"
                        BackgroundColor="{Binding Cells[6].BackgroundColor}"
                        Command="{Binding Cells[6].TapCommand}"
                        IsEnabled="{Binding Cells[6].IsEnabled}"
                        Style="{StaticResource CellButtonStyle}"/>

                <Button Grid.Row="2" Grid.Column="1"
                        Text="{Binding Cells[7].Symbol}"
                        TextColor="{Binding Cells[7].TextColor}"
                        BackgroundColor="{Binding Cells[7].BackgroundColor}"
                        Command="{Binding Cells[7].TapCommand}"
                        IsEnabled="{Binding Cells[7].IsEnabled}"
                        Style="{StaticResource CellButtonStyle}"/>

                <Button Grid.Row="2" Grid.Column="2"
                        Text="{Binding Cells[8].Symbol}"
                        TextColor="{Binding Cells[8].TextColor}"
                        BackgroundColor="{Binding Cells[8].BackgroundColor}"
                        Command="{Binding Cells[8].TapCommand}"
                        IsEnabled="{Binding Cells[8].IsEnabled}"
                        Style="{StaticResource CellButtonStyle}"/>

            </Grid>

        </VerticalStackLayout>

        <Button Grid.Row="2"
                Text="{Binding NewGameLabel}"
                Command="{Binding NewGameCommand}"
                IsEnabled="{Binding IsLoading, Converter={x:StaticResource InverseBoolConverter}}"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalOptions="Fill"/>

    </Grid>

</ContentPage>
